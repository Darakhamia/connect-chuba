# ===========================================
# Connect Chuba - Environment Variables
# Copy this file to .env (local) or .env.production (deploy)
# ===========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/connectchuba"

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# LiveKit - Voice/Video (https://livekit.io)
LIVEKIT_API_KEY=your-api-key-here
LIVEKIT_API_SECRET=your-secret-key-here
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# UploadThing - File uploads (https://uploadthing.com)
UPLOADTHING_TOKEN=your-uploadthing-token

# Music APIs (optional)
YOUTUBE_API_KEY=your-youtube-api-key
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
NEXT_PUBLIC_APPLE_MUSIC_TOKEN=your-apple-music-token

# App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
